# Copy to .env.production; choose a different hexadecimal password per environment.
COMPOSE_PROJECT_NAME=career-production
API_PORT=8002
POSTGRES_PASSWORD=replace_with_a_unique_random_hex_password
# Build once from a clean commit, validate in staging and reuse the exact image in production.
CAREER_APP_IMAGE=career-intelligence-os:replace_with_validated_commit_sha
